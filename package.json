{
  "name": "financial-immune-system",
  "version": "1.0.0",
  "description": "Financial Immune System - Systemic Control Intelligence for AI-Enabled Financial Ecosystems",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm run server\" \"npm run client\"",
    "server": "tsx server/src/index.ts",
    "client": "vite",
    "build:client": "tsc -b && vite build",
    "build:server": "esbuild server/src/serverless.ts --bundle --platform=node --format=esm --target=node24 --packages=external --outfile=api/index.js",
    "build": "npm run build:client && npm run build:server",
    "preview": "vite preview",
    "start": "tsx server/src/index.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "three": "^0.173.0",
    "tsx": "^4.19.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.173.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.2",
    "puppeteer-core": "^25.13.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
