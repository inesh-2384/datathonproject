# ==============================================================================
# FINANCIAL IMMUNE SYSTEM (FIS) — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Production Deployment Environment Variables
# NOTE: Never commit live credentials or secrets to version control.
# ==============================================================================

# [REQUIRED FOR HOSTING PLATFORMS]
# The network port the HTTP server binds to (provided automatically by Render, Railway, Heroku, Fly.io, etc.)
# Default: 3001 (or 3000 in unified local deployment)
PORT=3001

# [OPTIONAL / ENVIRONMENT MODE]
# Node execution environment mode: 'production' | 'development' | 'test'
# Default: production
NODE_ENV=production

# [OPTIONAL / NETWORK HOST BINDING]
# Network interface host address to bind to. Set to 0.0.0.0 for containerized / public deployments.
# Default: 0.0.0.0
HOST=0.0.0.0

# [OPTIONAL / DEMONSTRATION MODE]
# Deterministic PRNG seed for canonical scenario reproducibility (Section 2 & 13)
# Default: 42091
FIS_SIMULATION_SEED=42091

# [OPTIONAL / HARDWARE QUALIFICATION BADGE]
# Truthful hardware execution qualification string displayed across UI headers
# Default: LOCAL_SIMULATION [TARGET: IBM Z TELUM II / LINUXONE]
FIS_RUNTIME_QUALIFICATION=LOCAL_SIMULATION [TARGET: IBM Z TELUM II / LINUXONE]
